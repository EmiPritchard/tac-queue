# ── Atlassian OAuth 2.0 (3LO) ────────────────────────────────────────────────
# Create at https://developer.atlassian.com/console/myapps/
#   1. Create app -> OAuth 2.0 integration
#   2. Permissions -> Jira API -> add scopes: read:jira-work, read:jira-user
#   3. Authorization -> Callback URL -> must EXACTLY match APP_BASE_URL + /oauth/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Public URL this app is served from. No trailing slash.
# The OAuth callback is derived from it and must match the console exactly.
APP_BASE_URL=http://localhost:3000

# Random string, 32+ chars. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# Optional: pin the Atlassian site when the account can reach several.
ATLASSIAN_SITE_URL=https://access4.atlassian.net

# Jira projects the proxy is allowed to query, comma-separated. Requests for
# anything else are refused. TAC is the UK service desk and TAPC the ANZ one;
# the dashboard's desk switcher can only reach what is listed here.
# (The old single-project JIRA_PROJECT_KEY is still read when this is unset.)
JIRA_PROJECT_KEYS=TAC,TAPC

PORT=3000

# Set true when running behind a reverse proxy / load balancer terminating TLS,
# so secure cookies work correctly.
TRUST_PROXY=false

# Ticket QA database file (SQLite). Holds ticket keys and QA scores only, no
# customer data. Defaults to ./data/qa.sqlite. Back it up: it is the only copy.
# QA_DB_PATH=./data/qa.sqlite

# Skills Matrix database file (SQLite): the team's product ratings, their
# change history and the baseline. Defaults to ./data/skills.sqlite. Back it
# up too: it replaces the "UK Product Skills Matrix" spreadsheet.
# SKILLS_DB_PATH=./data/skills.sqlite
